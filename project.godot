; Engine configuration file.
; Godot 4.2 planar reflection demo.

config_version=5

[application]

config/name="Planar Mirror Lab"
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.027, 0.035, 0.05, 1)

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
speed_boost={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
reset_camera={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
toggle_run={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":80)]
}
