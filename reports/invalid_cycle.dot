digraph "invalid_cycle" {
  rankdir=LR;
  node [fontname="monospace"];
  p0 [label="#? pass_a\nR:ping W:pong",shape=box,style="filled",fillcolor="#dbeafe"];
  p1 [label="#? pass_b\nR:pong W:ping",shape=box,style="filled",fillcolor="#dbeafe"];
  r0 [label="ping\nRGBA8_UNORM",shape=ellipse,style="filled",fillcolor="#fef3c7"];
  r1 [label="pong\nRGBA8_UNORM",shape=ellipse,style="filled",fillcolor="#fef3c7"];
  p0 -> r1 [label="write"];
  r0 -> p0 [label="read"];
  p1 -> r0 [label="write"];
  r1 -> p1 [label="read"];
  e0 [label="cycle\ndependency cycle cannot be scheduled: pass_a -> pass_b -> pass_a",shape=note,style="filled",fillcolor="#fee2e2",color="#b91c1c"];
  p0 -> e0 [style=dotted,color="#b91c1c",label="error"];
}
