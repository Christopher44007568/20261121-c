digraph "invalid_missing_prerequisite" {
  rankdir=LR;
  node [fontname="monospace"];
  p0 [label="#? shadow_receiver\nR:shadow_map W:lit_scene",shape=box,style="filled",fillcolor="#dbeafe"];
  r0 [label="shadow_map\nR32_SFLOAT",shape=ellipse,style="filled",fillcolor="#fef3c7"];
  r1 [label="lit_scene\nRGBA16_SFLOAT",shape=ellipse,style="filled",fillcolor="#fef3c7"];
  p0 -> r1 [label="write"];
  r0 -> p0 [label="read"];
  e0 [label="uninitialized-read\nuninitialized read: pass 'shadow_receiver' reads 'shadow_map' before any pass produces it (missing prerequisite)",shape=note,style="filled",fillcolor="#fee2e2",color="#b91c1c"];
  p0 -> e0 [style=dotted,color="#b91c1c",label="error"];
}
