#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform image2D scene_input;
layout(set = 0, binding = 1, rgba16f) uniform image2D bloom_input;
layout(set = 0, binding = 2, rgba8) uniform image2D color_output;

layout(push_constant) uniform PushConstants {
    uvec4 dimensions;
} pc;

vec3 aces(vec3 value) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((value * (a * value + b)) /
                     (value * (c * value + d) + e),
                 vec3(0.0), vec3(1.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(pc.dimensions.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    ivec2 bloom_size = ivec2(pc.dimensions.zw);
    ivec2 bloom_pixel = min(pixel / 2, bloom_size - 1);
    vec3 hdr = imageLoad(scene_input, pixel).rgb;
    vec3 bloom = imageLoad(bloom_input, bloom_pixel).rgb;
    vec3 mapped = aces((hdr + bloom * 1.35) * 0.8);
    mapped = pow(mapped, vec3(1.0 / 2.2));
    imageStore(color_output, pixel, vec4(mapped, 1.0));
}
