#version 430 core

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) uniform readonly image2D uWboit;
layout(rgba16f, binding = 1) uniform readonly image2D uReference;
layout(r16f, binding = 2) uniform writeonly image2D uError;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uWboit);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    vec3 a = imageLoad(uWboit, pixel).rgb;
    vec3 b = imageLoad(uReference, pixel).rgb;
    vec3 delta = abs(a - b);
    float luminanceError = dot(delta, vec3(0.2126, 0.7152, 0.0722));
    imageStore(uError, pixel, vec4(luminanceError, 0.0, 0.0, 1.0));
}
